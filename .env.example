# =============================================================================
# SmartCare AI — Environment Configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# =============================================================================

# --- App ---------------------------------------------------------------------
# Production server runs on 3050 (3000 is taken); nginx proxies https://artsoraback.tech to it.
PORT=3050
# Comma-separated list of allowed browser origins (leave empty to allow all in dev)
CORS_ORIGINS=

# --- Database (PostgreSQL + Prisma) -------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartcare?schema=public

# --- JWT -----------------------------------------------------------------------
# Generate strong secrets:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-generate-a-long-random-secret
JWT_REFRESH_SECRET=change-me-generate-a-different-long-random-secret
# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_TTL=15m
# Refresh token lifetime in days
JWT_REFRESH_TTL_DAYS=7

# --- Redis (rate limiting) -----------------------------------------------------
# Optional: when unset, rate limiting uses in-memory storage (fine for local dev).
# Required in production / multi-instance deployments.
# Example: redis://localhost:6379
REDIS_URL=

# --- Email (verification & password-reset codes) -------------------------------
# Gmail SMTP linked to the project mailbox.
# MAIL_PASSWORD is a Google "App Password" (NOT the account password):
#   Google Account -> Security -> 2-Step Verification (enable) -> App passwords
# When MAIL_USER/MAIL_PASSWORD are empty, codes are printed to the server console (dev mode).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=obadayasser40@gmail.com
MAIL_PASSWORD=
MAIL_FROM="SmartCare AI <obadayasser40@gmail.com>"

# --- Firebase Admin (Google / Apple sign-in) ------------------------------------
# These come from the SERVICE ACCOUNT key, not the client config:
#   Firebase Console -> Project settings -> Service accounts -> Generate new private key
# Paste private_key with literal \n for newlines, wrapped in quotes.
FIREBASE_PROJECT_ID=ai-smart-care-5a23f
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# --- File storage ----------------------------------------------------------------
# Strategy pattern: "local" (default — files on this server, served at /files/*)
# or "r2" (Cloudflare R2, S3-compatible; fill the R2_* block below).
STORAGE_DRIVER=local
# Where local files are stored on disk
UPLOADS_DIR=./uploads
# Public base URL of this API (used to build file URLs)
# Production: https://artsoraback.tech — Local: http://localhost:3050
APP_URL=https://artsoraback.tech

# --- Cloudflare R2 (only if STORAGE_DRIVER=r2) ------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=smartcare-files
R2_PUBLIC_URL=
